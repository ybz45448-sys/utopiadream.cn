# ============================================================
# .env.example — 后端环境变量模板（第50天新增）
#
# 用途：列出项目【生产环境】需要设置的所有环境变量
# 使用方法：
#   1. 复制为 .env：cp .env.example .env
#   2. 把示例值改成真实值
#   3. 部署时由 Docker Compose 或系统加载（第51天会用到）
#   ⚠️ .env 已加入 .gitignore，绝不要提交真实秘密到 git
#
# 为什么要有这份模板？
#   部署的人（你/同事/CI）拿到代码，照着填就行，
#   不用去翻代码猜"到底要配哪些变量"。
# ============================================================

# 数据库连接（生产）
DB_URL=jdbc:postgresql://你的数据库地址:5432/utopia
DB_USERNAME=utopia_app
DB_PASSWORD=改成强密码

# JWT 签名密钥 —— 必须是很长的随机字符串！
# 生成命令（Linux）：openssl rand -hex 64
JWT_SECRET=改成随机字符串

# 允许访问后端的前端地址（多个用英文逗号分隔）
CORS_ALLOWED_ORIGINS=https://你的前端域名.com

# Token 有效期（毫秒，默认 24 小时，可不改）
JWT_EXPIRATION=86400000
