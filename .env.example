# ============================================================
# 根目录环境变量模板（Docker Compose 使用）
#
# 用途：列出 docker-compose.yml 需要读取的所有环境变量
# 使用方法：
#   1. 复制为 .env：cp .env.example .env
#   2. 把示例值改成真实值（本地开发可直接用下方示例值）
#   3. docker compose 会自动读取同目录的 .env 文件
#   ⚠️ .env 已加入 .gitignore，绝不要提交真实秘密到 git
#
# 本模板只占位，不含任何真实密钥。
# ============================================================

# ---------- PostgreSQL 容器初始化配置 ----------
POSTGRES_DB=utopia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=改成强密码

# ---------- Spring Boot 后端配置 ----------
# 生产环境用 prod；本地开发用 dev
SPRING_PROFILES_ACTIVE=prod
# 本地：jdbc:postgresql://localhost:5432/utopia
# Docker 内网：jdbc:postgresql://postgres:5432/utopia（主机名是 postgres，不是 localhost）
DB_URL=jdbc:postgresql://postgres:5432/utopia
DB_USERNAME=postgres
DB_PASSWORD=改成强密码
# JWT 签名密钥 —— 必须是很长的随机字符串！
# 生成命令（Linux）：openssl rand -hex 64
JWT_SECRET=改成随机字符串
# 允许访问后端的前端地址（多个用英文逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Token 有效期（毫秒，默认 24 小时，可不改）
JWT_EXPIRATION=86400000

# ---------- Next.js 前端配置 ----------
# NEXT_PUBLIC_ 前缀变量在构建时注入，浏览器能读到，不能放秘密
# 本地开发：http://localhost:8080
# 生产（同源走 Nginx）：留空 = 相对路径 /api
NEXT_PUBLIC_API_URL=http://localhost:8080
